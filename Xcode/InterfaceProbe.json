    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.interfaceprobe",
     "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
     "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
     "INFOPLIST_KEY_NSSupportsLiveActivities": "YES"
    }
   },
   "dependencies": [
    {
     "target": "ProbeLiveActivity",
     "embed": true
    },
    {
     "package": "SpotifyiOS",
     "product": "SpotifyiOS"
    }
   ],
   "info": {
    "path": "ProbeInfo.plist",
    "properties": {
     "CFBundleShortVersionString": "$(MARKETING_VERSION)",
     "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
     "UIBackgroundModes": [
      "audio"
     ],
     "NSSupportsLiveActivities": true,
     "CFBundleURLTypes": [
      {
       "CFBundleURLName": "local.ylcompanion.probe",
       "CFBundleURLSchemes": [
        "ylcompanion"
       ]
      }
     ]
    }
   }
  },
  "InterfaceProbeTests": {
   "type": "bundle.ui-testing",
   "platform": "iOS",
   "sources": [
    "InterfaceProbe/InteractionTests.swift"
   ],
   "dependencies": [
    {
     "target": "InterfaceProbe"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.interfaceprobetests"
    }
   }
  },
  "ProbeLiveActivity": {
   "type": "app-extension",
   "platform": "iOS",
   "sources": [
    {
     "path": "VehicleLiveActivity"
    },
    {
     "path": "LiveActivityShared"
    },
    {
     "path": "IslandAssets.xcassets"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.interfaceprobe.liveactivity",
     "PRODUCT_NAME": "ProbeLiveActivity",
     "APPLICATION_EXTENSION_API_ONLY": "YES",
     "SKIP_INSTALL": "YES"
    }
   },
   "info": {
    "path": "Generated/ProbeLiveActivity-Info.plist",
    "properties": {
     "CFBundleDisplayName": "YL Companion 현황",
     "CFBundleShortVersionString": "$(MARKETING_VERSION)",
     "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
     "NSExtension": {
      "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
     }
    }
   }
  }
