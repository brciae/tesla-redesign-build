 "schemes": {
  "InterfaceProbe": {
   "build": {
    "targets": {
     "InterfaceProbe": "all",
     "InterfaceProbeTests": [
      "test"
     ]
    }
   },
   "test": {
    "targets": [
     "InterfaceProbeTests"
    ]
   }
  }
 },
 "packages": {
  "SpotifyiOS": {
   "url": "https://github.com/spotify/ios-sdk.git",
   "exactVersion": "5.0.1"
  }
 }
}
