{
 "name": "InterfaceProbe",
 "options": {
  "deploymentTarget": {
   "iOS": "17.0"
  }
 },
 "settings": {
  "base": {
   "SWIFT_VERSION": "5.0",
   "CODE_SIGNING_ALLOWED": "NO",
   "TARGETED_DEVICE_FAMILY": "1,2",
   "GENERATE_INFOPLIST_FILE": "YES"
  }
 },
 "targets": {
  "InterfaceProbe": {
   "type": "application",
   "platform": "iOS",
   "sources": [
    "InterfaceProbe/App.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/DestinationSearchView.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/AppInterface.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/LocalBriefingControls.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/NavigationDashboard.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/ManeuverGlyph.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/BatteryOverview.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/BatteryGauge.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/InfoNote.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/DrivingSceneDecor.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/ChargingSceneDecor.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/VehicleAppearance.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/VehicleAppearanceStore.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/VehicleAppearanceMaterials.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/VehicleAppearanceView.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/VehicleSceneView.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/LocalRuntime.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/TypecastCatalog.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/TypecastClient.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/EmbeddedAppResources.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/TypecastAPIPolicy.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/BriefingStyle.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/TeslaInteractiveClimateView.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetInsightsView.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetTelemetryData.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetTelemetryStore.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetArchiveClient.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetTelemetryView.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetParkingAnalysis.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetSupplement.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetSupplementView.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/OwnershipAnalysis.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/OwnershipViews.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/FleetVehicleSnapshot.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/BriefingScope.swift",
    "../TeslaLocal.swiftpm/Sources/AppModule/ScreenBriefing.swift",
    {
     "path": "Assets.xcassets"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.interfaceprobe",
     "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
     "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight"
    }
   }
  },
  "InterfaceProbeTests": {
   "type": "bundle.ui-testing",
   "platform": "iOS",
   "sources": [
    "InterfaceProbe/InteractionTests.swift"
   ],
   "dependencies": [
    {
     "target": "InterfaceProbe"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.interfaceprobetests"
    }
   }
  }
 },
 "schemes": {
  "InterfaceProbe": {
   "build": {
    "targets": {
     "InterfaceProbe": "all",
     "InterfaceProbeTests": [
      "test"
     ]
    }
   },
   "test": {
    "targets": [
     "InterfaceProbeTests"
    ]
   }
  }
 }
}
