{
 "name": "YLCompanion",
 "options": {
  "minimumXcodeGenVersion": "2.38.0",
  "deploymentTarget": {
   "iOS": "17.0"
  },
  "createIntermediateGroups": true
 },
 "packages": {
  "KNSDK-UI": {
   "url": "https://github.com/kakaomob/KNSDK-UI.git",
   "exactVersion": "1.12.19"
  },
  "SpotifyiOS": {
   "url": "https://github.com/spotify/ios-sdk.git",
   "exactVersion": "5.0.1"
  }
 },
 "settings": {
  "base": {
   "SWIFT_VERSION": "5.0",
   "TARGETED_DEVICE_FAMILY": "1,2",
   "CODE_SIGNING_ALLOWED": "NO",
   "MARKETING_VERSION": "1.77",
   "CURRENT_PROJECT_VERSION": "177",
   "OTHER_LDFLAGS": "$(inherited) -ObjC"
  }
 },
 "targets": {
  "KakaoNavigationBridge": {
   "type": "framework",
   "platform": "iOS",
   "sources": [
    {
     "path": "KakaoNavigationBridge.h",
     "headerVisibility": "public"
    },
    {
     "path": "../TeslaLocal.swiftpm/Sources/KakaoNavigationBridge/YLKakaoController.m"
    },
    {
     "path": "../TeslaLocal.swiftpm/Sources/KakaoNavigationBridge/include",
     "headerVisibility": "public"
    }
   ],
   "dependencies": [
    {
     "package": "KNSDK-UI",
     "product": "KNSDK"
    },
    {
     "sdk": "AVFoundation.framework"
    },
    {
     "sdk": "UIKit.framework"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.navigationbridge",
     "DEFINES_MODULE": "YES",
     "CLANG_ENABLE_MODULES": "YES",
     "CLANG_ENABLE_OBJC_ARC": "YES",
     "GENERATE_INFOPLIST_FILE": "YES",
     "HEADER_SEARCH_PATHS": [
      "$(inherited)",
      "$(SRCROOT)/../TeslaLocal.swiftpm/Sources/KakaoNavigationBridge/include"
     ]
    }
   }
  },
  "YLCompanion": {
   "type": "application",
   "platform": "iOS",
   "sources": [
    {
     "path": "../TeslaLocal.swiftpm/Sources/AppModule",
     "excludes": [
      "Resources"
     ]
    },
    {
     "path": "Assets.xcassets"
    },
    {
     "path": "../TeslaLocal.swiftpm/Sources/AppModule/Resources/typecast_portraits",
     "type": "folder",
     "buildPhase": "resources"
    },
    {
     "path": "../TeslaLocal.swiftpm/Sources/AppModule/Resources/character",
     "type": "folder",
     "buildPhase": "resources"
    },
    {
     "path": "../TeslaLocal.swiftpm/Sources/AppModule/Resources/typecast_web_actors.json",
     "buildPhase": "resources"
    },
    {
     "path": "LiveActivityShared"
    },
    {
     "path": "LaunchScreen.storyboard"
    }
   ],
   "dependencies": [
    {
     "target": "KakaoNavigationBridge",
     "embed": true
    },
    {
     "package": "KNSDK-UI",
     "product": "KNSDK"
    },
    {
     "target": "VehicleLiveActivity",
     "embed": true
    },
    {
     "package": "SpotifyiOS",
     "product": "SpotifyiOS"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.app",
     "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
     "PRODUCT_NAME": "YLCompanion",
     "LD_RUNPATH_SEARCH_PATHS": [
      "$(inherited)",
      "@executable_path/Frameworks"
     ]
    }
   },
   "info": {
    "path": "Generated/Info.plist",
    "properties": {
     "CFBundleDisplayName": "YL Companion",
     "CFBundleShortVersionString": "$(MARKETING_VERSION)",
     "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
     "NSBluetoothAlwaysUsageDescription": "차량 상태를 조회하고, 직접 누른 제어 또는 직접 활성화한 탑승 공조 규칙의 명령을 근거리에서 전송합니다.",
     "CFBundleURLTypes": [
      {
       "CFBundleURLName": "local.ylcompanion.automation",
       "CFBundleURLSchemes": [
        "ylcompanion"
       ]
      }
     ],
     "NSCameraUsageDescription": "주차 위치 사진을 직접 촬영해 이 기기에만 저장하기 위해 카메라를 사용합니다.",
     "NSLocationWhenInUseUsageDescription": "테슬라에서 받은 목적지까지 앱 내부 길안내를 제공하기 위해 이 기기의 현재 위치를 카카오내비에 전달합니다.",
     "NSLocationAlwaysAndWhenInUseUsageDescription": "화면이 잠기거나 다른 앱을 사용하는 동안에도 진행 중인 차량 길안내의 위치를 수신하기 위해 위치 접근을 요청합니다. 길안내 종료 시 백그라운드 위치 수신을 중단합니다.",
     "NSLocationTemporaryUsageDescriptionDictionary": {
      "NavigationAccuracy": "현재 도로와 진행 방향에 맞는 길안내를 위해 정확한 위치를 사용합니다."
     },
     "UIBackgroundModes": [
      "bluetooth-central",
      "location",
      "audio"
     ],
     "LSApplicationQueriesSchemes": [
      "nmap",
      "tmap",
      "kakaonavi",
      "spotify"
     ],
     "UISupportedInterfaceOrientations": [
      "UIInterfaceOrientationPortrait",
      "UIInterfaceOrientationPortraitUpsideDown",
      "UIInterfaceOrientationLandscapeLeft",
      "UIInterfaceOrientationLandscapeRight"
     ],
     "UISupportedInterfaceOrientations~ipad": [
      "UIInterfaceOrientationPortrait",
      "UIInterfaceOrientationPortraitUpsideDown",
      "UIInterfaceOrientationLandscapeLeft",
      "UIInterfaceOrientationLandscapeRight"
     ],
     "NSSupportsLiveActivities": true,
     "UILaunchStoryboardName": "LaunchScreen",
     "CFBundleDevelopmentRegion": "ko",
     "CFBundleLocalizations": [
      "ko"
     ]
    }
   }
  },
  "VehicleLiveActivity": {
   "type": "app-extension",
   "platform": "iOS",
   "sources": [
    {
     "path": "VehicleLiveActivity"
    },
    {
     "path": "LiveActivityShared"
    },
    {
     "path": "IslandAssets.xcassets"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.app.liveactivity",
     "PRODUCT_NAME": "VehicleLiveActivity",
     "APPLICATION_EXTENSION_API_ONLY": "YES",
     "SKIP_INSTALL": "YES"
    }
   },
   "info": {
    "path": "Generated/LiveActivity-Info.plist",
    "properties": {
     "CFBundleDisplayName": "YL Companion 현황",
     "CFBundleShortVersionString": "$(MARKETING_VERSION)",
     "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
     "NSExtension": {
      "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
     },
     "CFBundleDevelopmentRegion": "ko",
     "CFBundleLocalizations": [
      "ko"
     ]
    }
   }
  },
  "ProductionReviewTests": {
   "type": "bundle.ui-testing",
   "platform": "iOS",
   "sources": [
    {
     "path": "ProductionReviewTests"
    }
   ],
   "dependencies": [
    {
     "target": "YLCompanion"
    }
   ],
   "settings": {
    "base": {
     "PRODUCT_BUNDLE_IDENTIFIER": "local.ylcompanion.productionreview",
     "GENERATE_INFOPLIST_FILE": "YES",
     "TEST_TARGET_NAME": "YLCompanion"
    }
   }
  }
 },
 "schemes": {
  "YLCompanion": {
   "build": {
    "targets": {
     "YLCompanion": "all"
    }
   },
   "run": {
    "config": "Debug"
   },
   "archive": {
    "config": "Release"
   },
   "test": {
    "config": "Debug",
    "targets": [
     {
      "name": "ProductionReviewTests"
     }
    ]
   }
  }
 }
}
